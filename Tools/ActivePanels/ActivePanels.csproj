<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 纯 Win32 互操作（user32 的 FindWindow/SendMessage、GDI+ 截图），无原生依赖 -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ActivePanels</AssemblyName>
    <RootNamespace>OmnimoTools.ActivePanels</RootNamespace>
    <Version>0.7.0.0</Version>
    <FileVersion>0.7.0.0</FileVersion>
    <ProductVersion>0.7.0.0</ProductVersion>
    <AssemblyTitle>ActivePanels</AssemblyTitle>
    <Company>Omnimo</Company>
    <Product>ReOmnimo</Product>
    <Copyright>Xyrfo 2013</Copyright>
    <Description>ReOmnimo ActivePanels</Description>
    <!-- 图标取自微软 Fluent UI System Icons（MIT），由 ..\Icons\make_icons.py 生成 -->
    <ApplicationIcon>..\Icons\ActivePanels.ico</ApplicationIcon>
    <!-- 不设 DPI 清单：保持与 AutoIt 版一致的 DPI 不感知语义 -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\OmnimoShared.cs" Link="OmnimoShared.cs" />
    <Compile Include="..\Shared\OmnimoShared.Tools.cs" Link="OmnimoShared.Tools.cs" />
  </ItemGroup>

</Project>
