<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 纯 Win32 互操作（user32 的 FindWindow/SendMessage/keybd_event、GDI+ 截图、kernel32 的光驱弹出），无原生依赖 -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OmnimoApp</AssemblyName>
    <RootNamespace>OmnimoTools.OmnimoApp</RootNamespace>
    <Version>0.7.0.0</Version>
    <FileVersion>0.7.0.0</FileVersion>
    <ProductVersion>0.7.0.0</ProductVersion>
    <AssemblyTitle>OmnimoApp</AssemblyTitle>
    <Company>Omnimo</Company>
    <Product>ReOmnimo</Product>
    <Copyright>Xyrfo 2013</Copyright>
    <Description>ReOmnimo OmnimoApp</Description>
    <!-- 图标取自微软 Fluent UI System Icons（MIT），由 ..\Icons\make_icons.py 生成 -->
    <ApplicationIcon>..\Icons\OmnimoApp.ico</ApplicationIcon>
    <!-- 不设 DPI 清单：保持与 AutoIt 版一致的 DPI 不感知语义（Screenshot 的 @DesktopWidth 与此同源） -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 共享源码按链接编进本 exe，不产出独立 DLL（与 ActivePanels / ColorChanger 同一形态） -->
    <Compile Include="..\Shared\OmnimoShared.cs" Link="OmnimoShared.cs" />
    <Compile Include="..\Shared\OmnimoShared.Tools.cs" Link="OmnimoShared.Tools.cs" />
    <Compile Include="..\Shared\AutoItValue.cs" Link="AutoItValue.cs" />
    <Compile Include="..\Shared\ColorSupport.cs" Link="ColorSupport.cs" />
  </ItemGroup>

</Project>
